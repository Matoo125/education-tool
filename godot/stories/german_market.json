			"color": "#d08c3c",
			"lines": [
				{
					"text": "Hallo! Peču Apfelkuchen na městskou slavnost, ale nemůžu odejít od trouby. Mohl bych tě poslat na trh? Prodavači tam mluví jenom německy.",
					"opens": true,
					"choices": [
						{
							"text": "Jasně! Co potřebujete?",
							"next": 1
						}
					],
					"unless": "shopping_list"
				},
				{
					"text": "Můj Einkaufszettel, nákupní seznam, leží na zemi u dveří, hned vedle tabulky čísel. Vezmi si obojí. Když chceš něco koupit, řekni „Ich möchte ..., bitte.“: Chci ..., prosím.",
					"opens": false,
					"choices": [
						{
							"text": "Už běžím!",
							"next": -1
						}
					]
				},
				{
					"text": "Máš můj seznam, wunderbar! Ukaž, co neseš. Nejdřív: máš Äpfel?",
					"opens": true,
					"choices": [
						{
							"text": "Hier sind drei Äpfel.",
							"next": 3,
							"requires": "apples"
						},
						{
							"text": "Ještě nemám nakoupeno.",
							"next": -1
						}
					],
					"requires": "shopping_list"
				},
				{
					"text": "Danke! A co Nüsse?",
					"opens": false,
					"choices": [
						{
							"text": "Hier sind sechs Nüsse.",
							"next": 4,
							"requires": "nuts"
						},
						{
							"text": "Ještě ne. Hned jsem zpátky!",
							"next": -1
						}
					]
				},
				{
					"text": "Sehr gut! A poslední věc ze seznamu?",
					"opens": false,
					"choices": [
						{
							"text": "Hier ist die Hafermilch.",
							"next": 5,
							"requires": "oat_milk"
						},
						{
							"text": "Ještě ne. Hned jsem zpátky!",
							"next": -1
						}
					]
				},
				{
					"text": "To je všechno! Teď mi pomoz péct. Kolik ořechů patří na koláč? Řekni to německy!",
					"opens": false,
					"choices": [
						{
							"text": "Sieben!",
							"next": 6
						},
						{
							"text": "Sechs!",
							"next": 7
						},
						{
							"text": "Drei!",
							"next": 6
						}
					]
				},
				{
					"text": "Hm, spočítáme ořechy spolu: eins, zwei, drei, vier, fünf, ... a ještě jedno. Co následuje po fünf?",
					"opens": false,
					"choices": [
						{
							"text": "Zkusím to znovu.",
							"next": 5
						}
					]
				},
				{
					"text": "Genau, sechs! A co nakrájím na plátky do koláče?",
					"opens": false,
					"choices": [
						{
							"text": "Die Nüsse.",
							"next": 8
						},
						{
							"text": "Die Äpfel.",
							"next": 9
						},
						{
							"text": "Die Hafermilch.",
							"next": 8
						}
					]
				},
				{
					"text": "To by byl divný koláč! Je to přece Apfelkuchen. Které slovo slyšíš ve slově „Apfelkuchen“?",
					"opens": false,
					"choices": [
						{
							"text": "Zkusím to znovu.",
							"next": 7
						}
					]
				},
				{
					"text": "Richtig, die Äpfel! Vielen Dank: mockrát děkuji. Koláč bude na slavnost včas hotový!",
					"opens": false,
					"choices": [
						{
							"text": "Bitte, Ben!",
							"next": -1,
							"ending": "Benův Apfelkuchen byl hvězdou městské slavnosti a celý nákup se ti povedl německy. Teď už umíš čísla od eins do zehn, slova Äpfel, Nüsse a Hafermilch a víš, jak si o něco zdvořile říct: Ich möchte ..., bitte."
						}
					]
				}
			]
		},
