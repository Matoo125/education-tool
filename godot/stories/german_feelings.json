			],
			"color": "#3f8f8b",
			"lines": [
				{
					"text": "Ahoj, já jsem Tina a starám se tady o zvířata. Dnes mi pomáháš ty! Zvířata ti německy řeknou, jak se cítí. Vezmi si kartičku pocitů, leží tady vedle mě.",
					"opens": true,
					"choices": [
						{
							"text": "Vezmu si ji!",
							"next": -1
						}
					],
					"unless": "feelings_card"
				},
				{
					"text": "Zeptej se každého zvířete, jak se má, a pomoz mu. Voda je u studny, seno a deka v kůlně. Tak co, jak se má ovečka Flocke?",
					"opens": true,
					"choices": [
						{
							"text": "Flocke ist glücklich.",
							"next": 2,
							"requires": "helped_flocke"
						},
						{
							"text": "Ještě nevím, jdu se zeptat.",
							"next": -1
						}
					],
					"requires": "feelings_card"
				},
				{
					"text": "Wunderbar! Und Berta?",
					"opens": false,
					"choices": [
						{
							"text": "Berta ist glücklich.",
							"next": 3,
							"requires": "helped_berta"
						},
						{
							"text": "Ještě ne, jdu jí pomoct.",
							"next": -1
						}
					]
				},
				{
					"text": "Sehr gut! Und Fips?",
					"opens": false,
					"choices": [
						{
							"text": "Fips ist glücklich.",
							"next": 4,
							"requires": "helped_fips"
						},
						{
							"text": "Ještě ne, jdu mu pomoct.",
							"next": -1
						}
					]
				},
				{
					"text": "Super! Und Minka?",
					"opens": false,
					"choices": [
						{
							"text": "Minka schläft. Sie ist glücklich.",
							"next": 5,
							"requires": "helped_minka"
						},
						{
							"text": "Ještě ne, jdu za ní.",
							"next": -1
						}
					]
				},
				{
					"text": "Schön! Und Henni?",
					"opens": false,
					"choices": [
						{
							"text": "Henni ist nicht allein. Sie ist glücklich.",
							"next": 6,
							"requires": "helped_henni"
						},
						{
							"text": "Ještě ne, jdu za ní.",
							"next": -1
						}
					]
				},
				{
					"text": "Všichni jsou glücklich, to je radost! Ještě mi pověz: Minka řekla „Ich bin müde.“ Co pro ni bylo nejlepší?",
					"opens": false,
					"choices": [
						{
							"text": "Vzít ji do náruče a hrát si s ní.",
							"next": 7
						},
						{
							"text": "Nechat ji v klidu spát.",
							"next": 8
						}
					]
				},
				{
					"text": "To by se jí nelíbilo. „Müde“ znamená unavená. Co potřebuješ ty, když se ti chce spát?",
					"opens": false,
					"choices": [
						{
							"text": "Zkusím to znovu.",
							"next": 6
						}
					]
				},
				{
					"text": "Přesně tak, klid. A co ti řekla Henni svým „Ich bin traurig“?",
					"opens": false,
					"choices": [
						{
							"text": "Mám žízeň.",
							"next": 9
						},
						{
							"text": "Jsem smutná.",
							"next": 10
						},
						{
							"text": "Je mi zima.",
							"next": 9
						}
					]
				},
				{
					"text": "To ne. Žízeň je „Durst“ a zima je „kalt“. Henni byla sama, „allein“. Jak jí asi bylo?",
					"opens": false,
					"choices": [
						{
							"text": "Zkusím to znovu.",
							"next": 8
						}
					]
				},
				{
					"text": "Ano, smutná. A stačilo s ní chvíli zůstat. Vielen Dank, jsi skvělá pomoc!",
					"opens": false,
					"choices": [
						{
							"text": "Gern geschehen, Tina!",
							"next": -1,
							"ending": "Všechna zvířata v azylu Sonnenhof jsou dnes glücklich. Umíš teď německy říct, jak se kdo cítí: Ich habe Hunger, Ich habe Durst, Mir ist kalt, Ich bin müde, Ich bin traurig, Ich bin glücklich. A víš, že zvířata cítí hlad, žízeň, zimu, únavu i samotu podobně jako my. Stačí se dívat, poslouchat a zeptat se: Was brauchst du?"
						}
					]
				}
			]
		},
