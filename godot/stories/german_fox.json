							"text": "Zkusím to znovu.",
							"next": 3
						}
					]
				},
				{
					"text": "Stop! Zraněné divoké zvíře se nebere do rukou: bojí se, bolí ho to a může kousnout. Zůstaň opodál a buď potichu.",
					"opens": false,
					"choices": [
						{
							"text": "Zkusím to znovu.",
							"next": 3
						}
					]
				},
				{
					"text": "Mein Bein tut weh. Und ich habe Angst.",
					"opens": false,
					"choices": [
						{
							"text": "Bolí tě nos a máš hlad?",
							"next": 7
