					],
					"unless": "notebook"
				},
				{
					"text": "Schuhu! Der Fuchs ist dort, bei den Steinen. Geh langsam und leise!",
					"opens": true,
					"choices": [
						{
							"text": "Danke, Frieda!",
							"next": -1
						}
					],
					"requires": "knows_fox"
				},
				{
					"text": "Schuhu! Hilfe! Der kleine Fuchs ist dort, bei den Steinen. Sein Bein tut weh!",
					"opens": true,
					"choices": [
						{
							"text": "Malou lišku bolí hlava?",
							"next": 3
						},
						{
							"text": "Malou lišku bolí noha?",
							"next": 4
						},
						{
							"text": "Malou lišku bolí ucho?",
							"next": 3
						}
					],
					"requires": "notebook"
				},
				{
					"text": "Frieda zamává křídly: „Nein! Sein Bein!“ Hlava je „der Kopf“ a ucho „das Ohr“. Najdi v zápisníku slovo „Bein“.",
					"opens": false,
					"choices": [
						{
							"text": "Zkusím to znovu.",
							"next": 2
						}
					]
				},
				{
					"text": "Ja! Aber Achtung: Der Fuchs hat Angst. Geh langsam und leise!",
					"opens": false,
					"choices": [
						{
							"text": "Mám běžet rychle a hlasitě volat?",
							"next": 5
						},
						{
							"text": "Mám jít pomalu a potichu?",
							"next": 6
						}
					]
				},
				{
					"text": "„Nein, nein!“ Rychle a nahlas je „schnell und laut“. Frieda řekla „langsam und leise“, protože liška má strach: „Der Fuchs hat Angst.“",
					"opens": false,
					"choices": [
						{
							"text": "Zkusím to znovu.",
							"next": 4
						}
					]
				},
				{
					"text": "Ja, genau! Der Fuchs ist bei den Steinen. (Frieda ukazuje křídlem ke kamenům na druhém konci lesa.)",
					"opens": false,
					"choices": [
						{
							"text": "Danke, Frieda!",
							"next": -1,
							"sets": "knows_fox"
						}
					]
				}
