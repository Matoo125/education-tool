							"text": "Ich hole Hilfe! (Přivedu pomoc!)",
							"next": -1
						}
					],
					"requires": "found_fox"
				},
				{
					"text": "(Liška je schovaná mezi kameny a nevyleze. V lese je moc hluku. Kdo to tu tak zpívá?)",
					"opens": true,
					"choices": [
						{
							"text": "(Jdeš zjistit, kdo dělá hluk.)",
							"next": -1
						}
					],
					"unless": "quiet"
				},
				{
					"text": "(Malá liška se na tebe dívá a třese se.) Ich habe Angst...",
					"opens": true,
					"choices": [
						{
							"text": "(Rychle k ní běžíš.) Komm her!",
							"next": 4
						},
						{
							"text": "(Pomalu si sedneš opodál.) Keine Angst. Ich bin leise.",
							"next": 6
						},
						{
							"text": "(Zkusíš ji vzít do náruče.)",
							"next": 5
						}
					],
					"requires": "quiet"
				},
				{
					"text": "Liška se přikrčí ještě víc. Divoké zvíře se bojí rychlých pohybů a hluku. Jak to říkala sova? Langsam und leise.",
					"opens": false,
					"choices": [
