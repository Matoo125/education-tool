			],
			"color": "#d9772e",
			"look": "fox",
			"lines": [
				{
					"text": "(Mezi kameny se něco pohnulo a schovalo. Nejdřív zjisti od sovy, co se tu stalo.)",
					"opens": true,
					"choices": [
						{
							"text": "(Necháš to být a jdeš za sovou.)",
							"next": -1
						}
					],
					"unless": "knows_fox"
				},
				{
					"text": "(Liška klidně leží mezi kameny a čeká.) Danke...",
					"opens": true,
					"choices": [
