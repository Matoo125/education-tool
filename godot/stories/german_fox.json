						{
							"text": "Bolí tě noha a máš strach?",
							"next": 8
						}
					]
				},
				{
					"text": "Liška zavrtí hlavou. Řekla: „Mein Bein tut weh. Ich habe Angst.“ Najdi „Bein“ a „Angst“ v zápisníku.",
					"opens": false,
					"choices": [
						{
							"text": "Zkusím to znovu.",
							"next": 6
						}
