			"color": "#d9577a",
			"lines": [
				{
					"text": "Ach ne, nemůžu nikde najít svého psa Bella! Zvířata ho viděla, ale mluví jenom německy. Tady vedle mě na zemi leží můj obrázkový slovník. Vezmi si ho a zeptej se jich, prosím!",
					"opens": true,
					"choices": [
						{
							"text": "Najdu ho!",
							"next": -1
						}
					],
					"unless": "dictionary"
				},
				{
					"text": "Ty víš, kde je nějaký pes? Počkej, musím si být jistá, že je to opravdu můj Bello. Jakou má barvu?",
					"opens": true,
					"choices": [
						{
							"text": "Er ist schwarz.",
							"next": 2
						},
						{
							"text": "Er ist blau.",
							"next": 2
						},
						{
							"text": "Er ist braun.",
							"next": 3
						}
					],
					"requires": "found_bello"
				},
				{
					"text": "To není můj Bello! Schwarz je černý a blau je modrý. Co ti říkala kráva Klara?",
					"opens": false,
					"choices": [
						{
							"text": "Ještě si to rozmyslím.",
							"next": 1
						}
					]
				},
				{
					"text": "Ja, braun! A je to velký pes, nebo malý?",
					"opens": false,
					"choices": [
						{
							"text": "Er ist klein.",
							"next": 5
						},
						{
							"text": "Er ist groß.",
							"next": 4
						}
					]
				},
				{
					"text": "Groß? Ne, velký pes není můj Bello. Ovce Wolli říkala „nicht groß“: není velký.",
					"opens": false,
					"choices": [
						{
							"text": "Ještě si to rozmyslím.",
							"next": 3
						}
					]
				},
				{
					"text": "Klein und braun, to je on! Kde je?",
					"opens": false,
					"choices": [
						{
							"text": "Er ist im Haus.",
							"next": 6
						},
						{
							"text": "Er ist im Wasser.",
							"next": 6
						},
						{
							"text": "Er ist im Wald.",
							"next": 7
						}
					]
				},
				{
					"text": "V domě, tedy im Haus, jsem už hledala, a Wasser, vodu, Bello nesnáší! Kde tedy doopravdy je?",
					"opens": false,
					"choices": [
						{
							"text": "Ještě si to rozmyslím.",
							"next": 5
						}
					]
				},
				{
					"text": "Im Wald! Moc ti děkuju. Bello, komm! Hodný pes!",
					"opens": false,
					"choices": [
						{
							"text": "Gern geschehen! (Rádo se stalo!)",
							"next": -1,
							"ending": "Bello běžel celou cestu domů a vrtěl ocasem. Podařilo se ti porozumět německým nápovědám zvířat: Bello je braun (hnědý) a klein (malý) a byl im Wald (v lese). Znáš teď také zvířata der Hund, die Kuh, das Schaf, die Ente a die Eule."
						}
					]
				},
				{
					"text": "Kráva Klara, ovce Wolli a kachna Emma Bella viděly. Zeptej se jich, jak vypadá a kam běžel!",
					"opens": true,
					"choices": [
						{
							"text": "Jdu na to!",
							"next": -1
						}
					],
					"requires": "dictionary"
				}
			]
		},
