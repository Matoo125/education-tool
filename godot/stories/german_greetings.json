			"color": "#d9577a",
			"lines": [
				{
					"text": "Ahoj, já jsem Mia! Vítej v Lindenbergu. Moje Oma, tedy babička, čeká doma, ale mluví jenom německy. Tady na zemi jsem ti nechala slovníček. Nejdřív si ho přečti!",
					"opens": true,
					"choices": [
						{
							"text": "Dobře, přečtu si ho.",
							"next": -1
						}
					],
					"unless": "phrase_book"
				},
				{
					"text": "Náš dům je ten žlutý na druhé straně náměstí. Oma už čeká! Viel Glück: to znamená hodně štěstí.",
					"opens": true,
					"choices": [
						{
							"text": "Danke, Mia!",
							"next": -1
						}
					],
					"requires": "practised"
				},
				{
					"text": "Máš slovníček? Tak si to vyzkoušíme. Je ráno a potkáš moji babičku. Co řekneš?",
					"opens": true,
					"choices": [
						{
							"text": "Guten Morgen!",
							"next": 4
						},
						{
							"text": "Gute Nacht!",
							"next": 3
						},
						{
							"text": "Tschüss!",
							"next": 3
						}
					],
					"requires": "phrase_book"
				},
				{
					"text": "To není ono. „Gute Nacht“ se říká před spaním a „Tschüss“ při loučení. Ve kterém pozdravu je slovo ráno?",
					"opens": false,
					"choices": [
						{
							"text": "Zkusím to znovu.",
							"next": 2
						}
					]
				},
				{
					"text": "Genau! To znamená „přesně“. A jak se zeptáš jiného dítěte, jak se jmenuje?",
					"opens": false,
					"choices": [
						{
							"text": "Wie geht's?",
							"next": 5
						},
						{
							"text": "Wie heißt du?",
							"next": 6
						},
						{
							"text": "Ich heiße Mia.",
							"next": 5
						}
					]
				},
				{
					"text": "Hm, ne. „Wie geht's?“ se ptá, jak se kdo má, a „Ich heiße ...“ říká tvoje vlastní jméno. Hledáš otázku se slovem „heißt“.",
					"opens": false,
					"choices": [
						{
							"text": "Zkusím to znovu.",
							"next": 4
						}
					]
				},
				{
					"text": "Super! Poslední otázka. Někdo ti dá dárek. Co řekneš?",
					"opens": false,
					"choices": [
						{
							"text": "Bitte!",
							"next": 7
						},
						{
							"text": "Danke!",
							"next": 8
						}
					]
				},
				{
					"text": "Skoro! „Bitte“ znamená prosím a říká se až jako odpověď na poděkování. Nejdřív musí zaznít slovo děkuji.",
					"opens": false,
					"choices": [
						{
							"text": "Zkusím to znovu.",
							"next": 6
						}
					]
				},
				{
					"text": "Výborně! U stánku s pečivem je můj kamarád Jonas; jestli chceš ještě trénovat, pozdrav ho. Potom běž za babičkou do žlutého domu.",
					"opens": false,
					"choices": [
						{
							"text": "Bis später! (Uvidíme se později!)",
							"next": -1,
							"sets": "practised"
